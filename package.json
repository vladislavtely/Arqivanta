{
  "name": "arqivanta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first architecture and code exploration for JavaScript and TypeScript.",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"node --watch apps/server/src/index.ts\" \"pnpm --filter @arqivanta/web dev\"",
    "build": "pnpm typecheck && pnpm --filter @arqivanta/web build",
    "start": "node apps/server/src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
